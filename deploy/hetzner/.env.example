# Copy to `.env` in this folder and fill in. This one file is read by Docker
# Compose (for ${...} in docker-compose.yml) AND passed into the api container.
# Keep it secret: chmod 600 .env, and it is gitignored.
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ─── Database (MongoDB in the mongo container) ─────────────────────────────────
DB_NAME=inc_logistics
# Root account (admin tasks, backups). Not used by the app.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-long-random
# Least-privilege account the API uses (created by mongo-init.js on first boot).
MONGO_APP_USER=inc_app
MONGO_APP_PASSWORD=change-me-long-random
# NOTE: MONGODB_URI is built from the parts above in docker-compose.yml — do not
# set it here.

# ─── Public hostname + HTTPS ───────────────────────────────────────────────────
# The API's own subdomain. Needs a DNS A record pointing at this server's IP.
API_DOMAIN=api.clinetteshipping.com
# Where Let's Encrypt sends expiry notices.
ACME_EMAIL=you@example.com
# The website's domain (needs its own A record). A preview host such as
# new.clinetteshipping.com until cutover, then clinetteshipping.com.
WEB_DOMAIN=clinetteshipping.com
# Other names that redirect to the site (space-separated; each needs an A record).
WEB_ALIASES=www.clinetteshipping.com new.clinetteshipping.com
# Where the frontend repo is, relative to this folder (default shown).
# FRONTEND_DIR=../../../inc_frontend

# ─── App runtime ───────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=15m
# Fresh secrets — the old ones were never handed over, so everyone signs in again
# once after cutover. That is expected.
JWT_SECRET=change-me-64+chars
JWT_REFRESH_SECRET=change-me-64+chars

# Frontend origins allowed by CORS (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://clinetteshipping.com,https://www.clinetteshipping.com
FRONTEND_URL=https://clinetteshipping.com

# ─── Google sign-in (create a new OAuth client you own) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be added verbatim under the OAuth client's "Authorised redirect URIs".
GOOGLE_CALLBACK_URL=https://api.clinetteshipping.com/api/auth/google/callback

# ─── Email (optional; notifications + contact form) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=I&C Logistics Co. <no-reply@inclogistics.com>
CONTACT_EMAIL=support@inclogistics.com

# ─── GPS + Maps (optional) ─────────────────────────────────────────────────────
GPS_WEBHOOK_SECRET=
GPS_PROVIDER=raw
GOOGLE_MAPS_API_KEY=

# ─── Tunables (optional; defaults shown) ───────────────────────────────────────
UPLOAD_RATE_LIMIT=60
STAFF_IDLE_TIMEOUT_MINUTES=30
SESSION_RATE_LIMIT=300
