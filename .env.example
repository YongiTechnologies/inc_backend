PORT=5000
NODE_ENV=development

# MongoDB — use MongoDB Atlas free tier
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
DB_NAME=inc_logistics

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://clinetteshipping.netlify.app,https://clinetteshipping.com,https://www.clinetteshipping.com

# Email (Nodemailer) — optional, for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=I&C Logistics Co. <no-reply@inclogistics.com>
CONTACT_EMAIL=support@inclogistics.com

# Google OAuth 2.0 — for Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# GPS Tracking (optional — only needed if using physical GPS devices)
# Shared secret GPS providers use to authenticate their webhooks
GPS_WEBHOOK_SECRET=your_gps_webhook_secret_here

# Google Maps API key — used for:
#   1. Reverse geocoding GPS pings to city/country names
#   2. Rendering the map on the frontend (Maps JavaScript API)
# Get one at: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# GPS Provider — which adapter to use: traccar | google | here | raw
GPS_PROVIDER=raw

# Spreadsheet uploads per staff member per hour (default 60). Applies only to
# the POST /api/batches/{intake,shipped,arrived,validate} endpoints — reading
# the batch list and retracting a wrong upload are never throttled.
UPLOAD_RATE_LIMIT=60

# Staff idle timeout in minutes (default 30, 0 disables). Enforced as a sliding
# window on the refresh token: a staff session that stops being used stops being
# renewed. Keep in step with SESSION_IDLE_MS in the frontend's src/config/constants.ts.
STAFF_IDLE_TIMEOUT_MINUTES=30

# Session-housekeeping requests per IP per 15 min (default 300) — /auth/me,
# /auth/refresh, /auth/logout. Kept well clear of the brute-force limiter on
# /auth/login, which a throttled refresh must never be confused with.
SESSION_RATE_LIMIT=300
